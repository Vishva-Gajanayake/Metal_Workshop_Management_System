<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="clientPaymentsPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.ClientPaymentsController">
   <children>
      <Label layoutX="24.0" layoutY="10.0" style="-fx-text-fill: #6B7280;" text="Deposits, settlements and balance due" />

      <!-- ===== Top Card: Select Job + Summary KPIs ===== -->
      <AnchorPane layoutX="24.0" layoutY="34.0" prefHeight="118.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Select Job" />
            <Label layoutX="16.0" layoutY="34.0" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="Job" />
            <ComboBox fx:id="jobCombo" layoutX="16.0" layoutY="54.0" onAction="#selectJobCombo" prefHeight="36.0" prefWidth="430.0" promptText="Select job order" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <!-- QUOTED KPI -->
            <AnchorPane layoutX="466.0" layoutY="18.0" prefHeight="82.0" prefWidth="176.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 8; -fx-border-radius: 8;">
               <children>
                  <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="82.0" prefWidth="5.0" style="-fx-background-color: #2E75B6; -fx-background-radius: 8 0 0 8;" />
                  <Label layoutX="16.0" layoutY="12.0" style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: bold;" text="QUOTED" />
                  <Label fx:id="quotedLbl" layoutX="16.0" layoutY="36.0" style="-fx-text-fill: #1F3864; -fx-font-size: 18px; -fx-font-weight: bold;" text="Rs. 0.00" />
               </children>
            </AnchorPane>

            <!-- PAID KPI -->
            <AnchorPane layoutX="654.0" layoutY="18.0" prefHeight="82.0" prefWidth="176.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 8; -fx-border-radius: 8;">
               <children>
                  <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="82.0" prefWidth="5.0" style="-fx-background-color: #2E9E5B; -fx-background-radius: 8 0 0 8;" />
                  <Label layoutX="16.0" layoutY="12.0" style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: bold;" text="PAID" />
                  <Label fx:id="paidLbl" layoutX="16.0" layoutY="36.0" style="-fx-text-fill: #1F3864; -fx-font-size: 18px; -fx-font-weight: bold;" text="Rs. 0.00" />
               </children>
            </AnchorPane>

            <!-- BALANCE KPI -->
            <AnchorPane layoutX="842.0" layoutY="18.0" prefHeight="82.0" prefWidth="174.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 8; -fx-border-radius: 8;">
               <children>
                  <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="82.0" prefWidth="5.0" style="-fx-background-color: #D64545; -fx-background-radius: 8 0 0 8;" />
                  <Label layoutX="16.0" layoutY="12.0" style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: bold;" text="BALANCE" />
                  <Label fx:id="balanceLbl" layoutX="16.0" layoutY="36.0" style="-fx-text-fill: #1F3864; -fx-font-size: 18px; -fx-font-weight: bold;" text="Rs. 0.00" />
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>

      <!-- ===== Middle Left Card: Record Payment ===== -->
      <AnchorPane layoutX="24.0" layoutY="166.0" prefHeight="422.0" prefWidth="444.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="18.0" layoutY="14.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Record Payment" />

            <Label layoutX="18.0" layoutY="46.0" style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Payment Type" />
            <ComboBox fx:id="paymentTypeCombo" layoutX="18.0" layoutY="68.0" prefHeight="34.0" prefWidth="408.0" promptText="Select payment type" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="18.0" layoutY="114.0" style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Amount (Rs.)" />
            <TextField fx:id="amountTxtField" layoutX="18.0" layoutY="136.0" prefHeight="34.0" prefWidth="408.0" promptText="0.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="18.0" layoutY="182.0" style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Payment Date" />
            <DatePicker fx:id="paymentDatePicker" layoutX="18.0" layoutY="204.0" prefHeight="34.0" prefWidth="408.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="18.0" layoutY="250.0" style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Method" />
            <ComboBox fx:id="methodCombo" layoutX="18.0" layoutY="272.0" prefHeight="34.0" prefWidth="408.0" promptText="Select method" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Button fx:id="savePaymentBtn" layoutX="18.0" layoutY="342.0" mnemonicParsing="false" onAction="#clickBtnSavePayment" prefHeight="38.0" prefWidth="156.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save Payment" />
            <Button fx:id="clearBtn" layoutX="186.0" layoutY="342.0" mnemonicParsing="false" onAction="#clickBtnClear" prefHeight="38.0" prefWidth="128.0" style="-fx-background-color: white; -fx-text-fill: #1F3864; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear" />
         </children>
      </AnchorPane>

      <!-- ===== Middle Right Card: Payment History ===== -->
      <AnchorPane layoutX="482.0" layoutY="166.0" prefHeight="422.0" prefWidth="574.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="18.0" layoutY="14.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Payment History" />

            <TableView fx:id="paymentHistoryTbl" layoutX="18.0" layoutY="46.0" prefHeight="296.0" prefWidth="538.0">
               <columns>
                  <TableColumn fx:id="colDate" prefWidth="105.0" text="Date" />
                  <TableColumn fx:id="colType" prefWidth="105.0" text="Type" />
                  <TableColumn fx:id="colAmount" prefWidth="120.0" text="Amount" />
                  <TableColumn fx:id="colMethod" prefWidth="98.0" text="Method" />
                  <TableColumn fx:id="colReceivedBy" prefWidth="108.0" text="Received By" />
               </columns>
            </TableView>

            <Label layoutX="18.0" layoutY="356.0" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="A payment cannot exceed the outstanding balance." />
         </children>
      </AnchorPane>

      <!-- ===== Bottom Bar: Generate Invoice ===== -->
      <Button fx:id="generateInvoiceBtn" layoutX="24.0" layoutY="606.0" mnemonicParsing="false" onAction="#clickBtnGenerateInvoice" prefHeight="40.0" prefWidth="168.0" style="-fx-background-color: #1F3864; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Generate Invoice" />
      <Label layoutX="206.0" layoutY="617.0" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="Invoice is created once the job is completed." />
   </children>
</AnchorPane>

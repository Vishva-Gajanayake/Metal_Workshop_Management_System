<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ClientPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.ClientsController">
   <children>
      <VBox prefHeight="720.0" prefWidth="1080.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-text-fill: #6B7280;" text="Manage workshop clients and contact details">
               <VBox.margin>
                  <Insets left="24.0" top="12.0" />
               </VBox.margin>
            </Label>

            <VBox prefHeight="288.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
               <children>
                  <Label style="-fx-text-fill: #1F3864;" text="Client Details">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="8.0" left="16.0" top="14.0" />
                     </VBox.margin>
                  </Label>
                  <HBox prefHeight="168.0" prefWidth="1000.0">
                     <children>
                        <VBox prefHeight="168.0" prefWidth="500.0" spacing="10.0">
                           <children>
                              <VBox prefHeight="66.0" prefWidth="480.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Full Name" />
                                    <TextField fx:id="nameTxtField" prefHeight="34.0" prefWidth="470.0" promptText="Enter full name" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                                 <VBox.margin>
                                    <Insets left="16.0" right="10.0" />
                                 </VBox.margin>
                              </VBox>
                              <VBox prefHeight="66.0" prefWidth="480.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Phone" />
                                    <TextField fx:id="phoneTxtField" prefHeight="34.0" prefWidth="470.0" promptText="e.g. 0771234567" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                                 <VBox.margin>
                                    <Insets left="16.0" right="10.0" />
                                 </VBox.margin>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox prefHeight="168.0" prefWidth="500.0" spacing="10.0">
                           <children>
                              <VBox prefHeight="66.0" prefWidth="480.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Email" />
                                    <TextField fx:id="emailTxtField" prefHeight="34.0" prefWidth="470.0" promptText="client@example.com" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                                 <VBox.margin>
                                    <Insets left="10.0" right="16.0" />
                                 </VBox.margin>
                              </VBox>
                              <VBox prefHeight="66.0" prefWidth="480.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Address" />
                                    <TextField fx:id="addressTxtField" prefHeight="34.0" prefWidth="470.0" promptText="Site or billing address" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                                 <VBox.margin>
                                    <Insets left="10.0" right="16.0" />
                                 </VBox.margin>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="1000.0" spacing="14.0">
                     <children>
                        <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#clickSaveBtn" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save Client" />
                        <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#clickUpdateBtn" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Update Client" />
                        <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#clickBtnDelete" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Delete" />
                        <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#clickClearBtn" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear Form" />
                     </children>
                     <padding>
                        <Insets left="16.0" />
                     </padding>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets bottom="12.0" left="24.0" right="24.0" top="8.0" />
               </VBox.margin>
            </VBox>

            <VBox prefHeight="368.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1000.0" spacing="12.0">
                     <children>
                        <TextField fx:id="searchTxtField" onKeyPressed="#pressSearchClient" prefHeight="34.0" prefWidth="300.0" promptText="Client ID, e.g. C001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#clickBtnSearch" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Search" />
                     </children>
                     <padding>
                        <Insets left="16.0" right="16.0" top="10.0" />
                     </padding>
                  </HBox>
                  <TableView fx:id="clientsTbl" prefHeight="286.0" prefWidth="1000.0">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="110.0" text="ID" />
                      <TableColumn fx:id="colName" prefWidth="260.0" text="Name" />
                        <TableColumn fx:id="colPhone" prefWidth="150.0" text="Phone" />
                        <TableColumn fx:id="colEmail" prefWidth="240.0" text="Email" />
                        <TableColumn fx:id="colAddress" prefWidth="230.0" text="Address" />
                    </columns>
                     <VBox.margin>
                        <Insets bottom="14.0" left="16.0" right="16.0" top="4.0" />
                     </VBox.margin>
                  </TableView>
               </children>
               <VBox.margin>
                  <Insets bottom="16.0" left="24.0" right="24.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
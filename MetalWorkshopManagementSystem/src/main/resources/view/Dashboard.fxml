      <Label fx:id="overviewSubtitleLbl" layoutX="24.0" layoutY="12.0" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Business overview for November 2026" />

      <!-- ===== Row 1: Primary KPI Cards ===== -->
      <!-- Active Jobs -->
      <AnchorPane layoutX="24.0" layoutY="42.0" prefHeight="116.0" prefWidth="244.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">

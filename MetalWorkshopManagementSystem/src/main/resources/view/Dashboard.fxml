      </AnchorPane>

      <!-- Financial & Inventory Summary -->
      <AnchorPane layoutX="548.0" layoutY="178.0" prefHeight="256.0" prefWidth="508.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">

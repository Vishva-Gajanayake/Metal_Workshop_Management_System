            <Label layoutX="20.0" layoutY="194.0" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Raw Material Stock Value" />
            <Label fx:id="stockValueLbl" layoutX="260.0" layoutY="194.0" prefWidth="226.0" style="-fx-text-fill: #2E75B6; -fx-font-size: 14px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT;" text="Rs. 0.00" />

            <AnchorPane layoutX="262.0" layoutY="158.0" prefHeight="76.0" prefWidth="224.0" style="-fx-background-color: #F9FAFC; -fx-border-color: #E5E7EB; -fx-background-radius: 8; -fx-border-radius: 8;">

            <Button fx:id="recordPaymentBtn" layoutX="356.0" layoutY="64.0" mnemonicParsing="false" onAction="#clickRecordPayment" prefHeight="36.0" prefWidth="156.0" style="-fx-background-color: #1F3864; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Record Payment" />
            <Button fx:id="viewStockBtn" layoutX="524.0" layoutY="64.0" mnemonicParsing="false" onAction="#clickViewStock" prefHeight="36.0" prefWidth="156.0" style="-fx-background-color: white; -fx-text-fill: #1F3864; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Material Stock" />
            <Button fx:id="refreshBtn" layoutX="882.0" layoutY="64.0" mnemonicParsing="false" onAction="#clickRefresh" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Refresh" />

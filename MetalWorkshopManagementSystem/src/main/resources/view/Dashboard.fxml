      <!-- ===== Row 3: Quick Actions Card ===== -->
      <AnchorPane layoutX="24.0" layoutY="454.0" prefHeight="118.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="16.0" style="-fx-text-fill: #1F3864; -fx-font-size: 15px; -fx-font-weight: bold;" text="Quick Actions" />
            <Label layoutX="20.0" layoutY="38.0" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="Jump straight into frequent workshop tasks" />

            <Button fx:id="newEstimateBtn" layoutX="20.0" layoutY="64.0" mnemonicParsing="false" onAction="#clickNewEstimate" prefHeight="36.0" prefWidth="156.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="New Estimate" />

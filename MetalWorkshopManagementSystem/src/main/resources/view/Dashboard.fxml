      <AnchorPane layoutX="286.0" layoutY="42.0" prefHeight="116.0" prefWidth="244.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">

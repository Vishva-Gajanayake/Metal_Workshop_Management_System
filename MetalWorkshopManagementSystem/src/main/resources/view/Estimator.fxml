<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="estimatorPane" prefHeight="720.0" prefWidth="1080.0"
            style="-fx-background-color: #F4F6FA;"
            stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.EstimatorController">
   <children>

      <!-- ===== Page subtitle ===== -->
      <Label layoutX="24.0" layoutY="12.0"
             text="Convert site measurements into material and labour cost"
             style="-fx-text-fill: #6B7280;" />

      <!-- ===== Estimate details card (left) ===== -->
      <AnchorPane layoutX="24.0" layoutY="44.0" prefHeight="618.0" prefWidth="586.0"
                  style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="14.0" text="Estimate Details"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" />

            <Label layoutX="20.0" layoutY="54.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Inquiry" />
            <ComboBox fx:id="inquiryCombo" layoutX="20.0" layoutY="76.0" prefHeight="34.0" prefWidth="546.0" promptText="Select inquiry" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="130.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Width (m)" />
            <TextField fx:id="widthTxtField" layoutX="20.0" layoutY="152.0" prefHeight="34.0" prefWidth="172.0" promptText="e.g. 3.5" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="207.0" layoutY="130.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Height (m)" />
            <TextField fx:id="heightTxtField" layoutX="207.0" layoutY="152.0" prefHeight="34.0" prefWidth="172.0" promptText="e.g. 1.8" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="394.0" layoutY="130.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Length (m)" />
            <TextField fx:id="lengthTxtField" layoutX="394.0" layoutY="152.0" prefHeight="34.0" prefWidth="172.0" promptText="0 if not used" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="206.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Quantity" />
            <TextField fx:id="quantityTxtField" layoutX="20.0" layoutY="228.0" prefHeight="34.0" prefWidth="264.0" promptText="e.g. 1" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="302.0" layoutY="206.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Wastage %" />
            <TextField fx:id="wastageTxtField" layoutX="302.0" layoutY="228.0" prefHeight="34.0" prefWidth="264.0" promptText="e.g. 8" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="282.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Material Cost (Rs.)" />
            <TextField fx:id="materialCostTxtField" layoutX="20.0" layoutY="304.0" prefHeight="34.0" prefWidth="264.0" promptText="e.g. 27654.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="302.0" layoutY="282.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Overhead (Rs.)" />
            <TextField fx:id="overheadTxtField" layoutX="302.0" layoutY="304.0" prefHeight="34.0" prefWidth="264.0" promptText="e.g. 3000.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Button fx:id="calculateBtn" layoutX="20.0" layoutY="372.0" mnemonicParsing="false"
                    onAction="#clickBtnCalculate" prefHeight="40.0" prefWidth="546.0" text="CALCULATE"
                    style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6; -fx-cursor: hand;" />

            <Label layoutX="20.0" layoutY="432.0" prefWidth="546.0" wrapText="true"
                   text="Size = width x height x length x quantity (length defaults to 1 if 0). Labour = size x service category labour rate."
                   style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
         </children>
      </AnchorPane>

      <!-- ===== Cost summary card (right) ===== -->
      <AnchorPane layoutX="626.0" layoutY="44.0" prefHeight="618.0" prefWidth="430.0"
                  style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="14.0" text="Cost Summary"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" />

            <Label layoutX="20.0" layoutY="64.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Labour Cost (Rs.)" />
            <TextField fx:id="labourTxtField" editable="false" layoutX="20.0" layoutY="86.0" prefHeight="40.0" prefWidth="390.0"
                       style="-fx-background-color: #F4F6FA; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-font-size: 15px; -fx-font-weight: bold;" />

            <Label layoutX="20.0" layoutY="152.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="TOTAL COST (Rs.)" />
            <TextField fx:id="totalTxtField" editable="false" layoutX="20.0" layoutY="174.0" prefHeight="50.0" prefWidth="390.0"
                       style="-fx-background-color: #E3F5EA; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E9E5B;" />

            <Label layoutX="20.0" layoutY="246.0" prefWidth="390.0" wrapText="true"
                   text="Total = material cost (including wastage %) + labour cost + overhead."
                   style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />

            <Button fx:id="saveBtn" layoutX="20.0" layoutY="340.0" mnemonicParsing="false"
                    onAction="#clickBtnSave" prefHeight="40.0" prefWidth="390.0" text="Save Estimate"
                    style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button fx:id="clearBtn" layoutX="20.0" layoutY="394.0" mnemonicParsing="false"
                    onAction="#clickBtnClear" prefHeight="40.0" prefWidth="390.0" text="Clear Form"
                    style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" />
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="goodsReceivedPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.GoodsReceivedController">
   <children>
      <Label layoutX="24.0" layoutY="12.0" style="-fx-text-fill: #6B7280;" text="Record supplier deliveries; stock updates automatically" />

      <!-- ===== Delivery details ===== -->
      <AnchorPane layoutX="24.0" layoutY="38.0" prefHeight="106.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Delivery Details" />

            <Label layoutX="16.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Supplier" />
            <ComboBox fx:id="supplierCombo" layoutX="16.0" layoutY="58.0" prefHeight="34.0" prefWidth="260.0" promptText="Select supplier" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="294.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Received Date" />
            <DatePicker fx:id="receivedDatePicker" layoutX="294.0" layoutY="58.0" prefHeight="34.0" prefWidth="190.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="502.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Supplier Invoice Ref" />
            <TextField fx:id="invoiceRefTxtField" layoutX="502.0" layoutY="58.0" prefHeight="34.0" prefWidth="215.0" promptText="e.g. INV-88421" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="735.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Received By" />
            <ComboBox fx:id="userCombo" layoutX="735.0" layoutY="58.0" prefHeight="34.0" prefWidth="281.0" promptText="Select user" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
         </children>
      </AnchorPane>

      <!-- ===== Delivery items ===== -->
      <AnchorPane layoutX="24.0" layoutY="156.0" prefHeight="316.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Delivery Items" />

            <Label layoutX="16.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Material" />
            <ComboBox fx:id="materialCombo" layoutX="16.0" layoutY="58.0" prefHeight="34.0" prefWidth="290.0" promptText="Select material" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="324.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Quantity" />
            <TextField fx:id="quantityTxtField" layoutX="324.0" layoutY="58.0" prefHeight="34.0" prefWidth="130.0" promptText="0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="472.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Unit Cost (Rs.)" />
            <TextField fx:id="unitCostTxtField" layoutX="472.0" layoutY="58.0" prefHeight="34.0" prefWidth="150.0" promptText="0.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Button fx:id="addItemBtn" layoutX="640.0" layoutY="58.0" mnemonicParsing="false" onAction="#clickBtnAddItem" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Add Item" />

            <TableView fx:id="itemsTbl" layoutX="16.0" layoutY="104.0" prefHeight="152.0" prefWidth="1000.0">
               <columns>
                  <TableColumn fx:id="colItemMaterial" prefWidth="295.0" text="Material" />
                  <TableColumn fx:id="colItemQty" prefWidth="200.0" text="Quantity" />
                  <TableColumn fx:id="colItemUnitCost" prefWidth="200.0" text="Unit Cost" />
                  <TableColumn fx:id="colItemLineTotal" prefWidth="210.0" text="Line Total" />
                  <TableColumn fx:id="removeCol" prefWidth="92.0" text="Remove" />
               </columns>
            </TableView>

            <Label layoutX="16.0" layoutY="270.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Total:" />
            <Label fx:id="totalLbl" layoutX="72.0" layoutY="270.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E9E5B;" text="Rs. 0.00" />

            <Button fx:id="saveBtn" layoutX="714.0" layoutY="266.0" mnemonicParsing="false" onAction="#clickBtnSave" prefHeight="36.0" prefWidth="176.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save Delivery" />
            <Button fx:id="clearBtn" layoutX="900.0" layoutY="266.0" mnemonicParsing="false" onAction="#clickBtnClear" prefHeight="36.0" prefWidth="116.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear" />
         </children>
      </AnchorPane>

      <!-- ===== Recent deliveries ===== -->
      <AnchorPane layoutX="24.0" layoutY="484.0" prefHeight="182.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Recent Deliveries" />
            <TableView fx:id="historyTbl" layoutX="16.0" layoutY="36.0" prefHeight="134.0" prefWidth="1000.0">
               <columns>
                  <TableColumn fx:id="colGrnId" prefWidth="98.0" text="GRN" />
                  <TableColumn fx:id="colGrnDate" prefWidth="150.0" text="Date" />
                  <TableColumn fx:id="colGrnSupplier" prefWidth="438.0" text="Supplier" />
                  <TableColumn fx:id="colGrnInvoice" prefWidth="150.0" text="Invoice Ref" />
                  <TableColumn fx:id="colGrnTotal" prefWidth="162.0" text="Total" />
               </columns>
            </TableView>
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
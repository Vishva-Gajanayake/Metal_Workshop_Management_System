<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="InquiriesPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.InquiriesControllers">
   <children>
      <Label layoutX="24.0" layoutY="12.0" style="-fx-text-fill: #6B7280;" text="Log client inquiries, schedule site visits, and track status" />

      <!-- ===== Left card: Search + Table ===== -->
      <AnchorPane layoutX="24.0" layoutY="44.0" prefHeight="618.0" prefWidth="586.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="14.0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Client Inquiries" />

            <TextField fx:id="searchTxtField" layoutX="20.0" layoutY="48.0" onKeyPressed="#pressSearchInquiry" prefHeight="34.0" prefWidth="426.0" promptText="Inquiry ID, e.g. IQ001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
            <Button fx:id="searchBtn" layoutX="456.0" layoutY="48.0" mnemonicParsing="false" onAction="#clickBtnSearch" prefHeight="34.0" prefWidth="110.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Search" />

            <TableView fx:id="inquiryTbl" layoutX="20.0" layoutY="96.0" prefHeight="502.0" prefWidth="546.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="82.0" text="ID" />
                  <TableColumn fx:id="colClient" prefWidth="150.0" text="Client" />
                  <TableColumn fx:id="colCategory" prefWidth="142.0" text="Category" />
                  <TableColumn fx:id="colVistDate" prefWidth="92.0" text="Site Visit" />
                  <TableColumn fx:id="colStatus" prefWidth="78.0" text="Status" />
               </columns>
            </TableView>
         </children>
      </AnchorPane>

      <!-- ===== Right card: Inquiry Details Form ===== -->
      <AnchorPane layoutX="626.0" layoutY="44.0" prefHeight="618.0" prefWidth="430.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="14.0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Inquiry Details" />

            <Label layoutX="20.0" layoutY="48.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Client" />
            <ComboBox fx:id="clientCombo" layoutX="20.0" layoutY="68.0" prefHeight="34.0" prefWidth="390.0" promptText="Select client" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="112.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Service Category" />
            <ComboBox fx:id="categoryCombo" layoutX="20.0" layoutY="132.0" prefHeight="34.0" prefWidth="390.0" promptText="Select service category" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="176.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Site Location" />
            <TextField fx:id="locationTxtField" layoutX="20.0" layoutY="196.0" prefHeight="34.0" prefWidth="390.0" promptText="Enter site location" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="240.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Description" />
            <TextField fx:id="descriptionTxtField" layoutX="20.0" layoutY="260.0" prefHeight="34.0" prefWidth="390.0" promptText="Project requirements / notes" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="20.0" layoutY="304.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Site Visit Date" />
            <DatePicker fx:id="visitDatePicker" layoutX="20.0" layoutY="324.0" prefHeight="34.0" prefWidth="188.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="222.0" layoutY="304.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Status" />
            <ComboBox fx:id="statusCombo" layoutX="222.0" layoutY="324.0" prefHeight="34.0" prefWidth="188.0" promptText="Select status" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Button fx:id="saveBtn" layoutX="20.0" layoutY="386.0" mnemonicParsing="false" onAction="#clickBtnSave" prefHeight="38.0" prefWidth="122.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save" />
            <Button fx:id="updateBtn" layoutX="154.0" layoutY="386.0" mnemonicParsing="false" onAction="#clickBtnUpdate" prefHeight="38.0" prefWidth="122.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Update" />
            <Button fx:id="deleteBtn" layoutX="288.0" layoutY="386.0" mnemonicParsing="false" onAction="#clickBtnDelete" prefHeight="38.0" prefWidth="122.0" style="-fx-background-color: #D64545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Delete" />

            <Button mnemonicParsing="false" onAction="#clickBtnClear" prefHeight="38.0" prefWidth="390.0" layoutX="20.0" layoutY="436.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear Form" />
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.LoginController">
   <center>
      <HBox prefHeight="720.0" prefWidth="1280.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Left Brand Panel -->
            <AnchorPane prefHeight="720.0" prefWidth="580.0" style="-fx-background-color: #1F3864;">
               <children>
                  <VBox alignment="CENTER_LEFT" layoutX="72.0" layoutY="205.0" prefHeight="310.0" prefWidth="436.0" spacing="12.0">
                     <children>
                        <Text fill="#60A5FA" strokeType="OUTSIDE" strokeWidth="0.0" text="WORKSHOP MANAGEMENT SYSTEM" wrappingWidth="436.0">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Text>

                        <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Gajanayake Engineering Works" wrappingWidth="436.0">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                        </Text>

                        <Text fill="#CBD5E1" strokeType="OUTSIDE" strokeWidth="0.0" text="Streamlined fabrication operations, inventory control, job tracking, and client billing." wrappingWidth="436.0">
                           <font>
                              <Font size="14.5" />
                           </font>
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Text>

                        <Text fill="#94A3B8" strokeType="OUTSIDE" strokeWidth="0.0" text="Estimates  •  Materials &amp; Stock  •  Job Orders  •  Payments" wrappingWidth="436.0">
                           <font>
                              <Font size="12.5" />
                           </font>
                           <VBox.margin>
                              <Insets top="24.0" />
                           </VBox.margin>
                        </Text>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>

            <!-- Right Sign-In Panel -->
            <AnchorPane prefHeight="720.0" prefWidth="700.0" style="-fx-background-color: #F4F6FA;">
               <children>
                  <VBox layoutX="135.0" layoutY="130.0" prefHeight="460.0" prefWidth="430.0" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #D9DEE7; -fx-border-radius: 12; -fx-padding: 32 36 28 36;">
                     <children>
                        <Text fill="#1F3864" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome back">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Text>

                        <Text fill="#6B7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Sign in to access your workspace">
                           <font>
                              <Font size="13.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="14.0" />
                           </VBox.margin>
                        </Text>

                        <!-- Username -->
                        <Text fill="#1F3864" strokeType="OUTSIDE" strokeWidth="0.0" text="Username">
                           <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                        </Text>
                        <TextField fx:id="usernameTxt" prefHeight="38.0" promptText="Enter username" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 0 12 0 12;">
                           <font>
                              <Font size="13.5" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </TextField>

                        <!-- Password -->
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Text fill="#1F3864" strokeType="OUTSIDE" strokeWidth="0.0" text="Password">
                                 <font>
                                    <Font name="System Bold" size="12.5" />
                                 </font>
                              </Text>
                              <HBox HBox.hgrow="ALWAYS" />
                              <Button fx:id="showPasswordBtn" mnemonicParsing="false" onAction="#clickShowBtn" style="-fx-background-color: transparent; -fx-text-fill: #2E75B6; -fx-font-weight: bold; -fx-font-size: 11.5px; -fx-cursor: hand; -fx-padding: 0;" text="SHOW" />
                           </children>
                        </HBox>

                        <StackPane prefHeight="38.0">
                           <children>
                              <TextField fx:id="showPassTxtField" prefHeight="38.0" promptText="Enter password" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 0 12 0 12;">
                                 <font>
                                    <Font size="13.5" />
                                 </font>
                              </TextField>
                              <PasswordField fx:id="passwordTxt" prefHeight="38.0" promptText="Enter password" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 0 12 0 12;">
                                 <font>
                                    <Font size="13.5" />
                                 </font>
                              </PasswordField>
                           </children>
                        </StackPane>

                        <!-- Sign In Button -->
                        <Button fx:id="loginBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickLogingBtn" prefHeight="40.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13.5px; -fx-background-radius: 6; -fx-cursor: hand;" text="Sign In">
                           <VBox.margin>
                              <Insets top="18.0" />
                           </VBox.margin>
                        </Button>

                        <!-- Status Message -->
                        <Text fx:id="loginStatusLabel" fill="#D64545" strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="358.0">
                           <font>
                              <Font size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                        </Text>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="MaterialStockPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.MaterialStockController">
   <children>
      <Label layoutX="24.0" layoutY="12.0" style="-fx-text-fill: #6B7280;" text="Manage raw material inventory, unit costs, and reorder alerts" />

      <!-- ===== Top card: Search + Low Stock + Table ===== -->
      <AnchorPane layoutX="24.0" layoutY="42.0" prefHeight="342.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <TextField fx:id="searchTxtField" layoutX="16.0" layoutY="16.0" onKeyPressed="#pressSearchMaterial" prefHeight="34.0" prefWidth="320.0" promptText="Material code, e.g. ST-001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
            <Button layoutX="346.0" layoutY="16.0" mnemonicParsing="false" onAction="#clickBtnSearch" prefHeight="34.0" prefWidth="110.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Search" />
            <Button layoutX="468.0" layoutY="16.0" mnemonicParsing="false" onAction="#clickBtnLowStock" prefHeight="34.0" prefWidth="140.0" style="-fx-background-color: #D9A441; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Low Stock" />

            <TableView fx:id="materialTbl" layoutX="16.0" layoutY="62.0" prefHeight="242.0" prefWidth="1000.0">
               <columns>
                  <TableColumn fx:id="colCode" prefWidth="110.0" text="Code" />
                  <TableColumn fx:id="colName" prefWidth="210.0" text="Material Name" />
                  <TableColumn fx:id="colType" prefWidth="150.0" text="Type" />
                  <TableColumn fx:id="colUnit" prefWidth="120.0" text="Unit" />
                  <TableColumn fx:id="colUnitCost" prefWidth="145.0" text="Unit Cost" />
                  <TableColumn fx:id="colQty" prefWidth="145.0" text="On Hand" />
                  <TableColumn fx:id="colStatus" prefWidth="118.0" text="Status" />
               </columns>
            </TableView>

            <Label fx:id="recordCount" layoutX="16.0" layoutY="312.0" style="-fx-text-fill: #6B7280;" text="Showing 0 of 0 records" />
         </children>
      </AnchorPane>

      <!-- ===== Bottom card: Material Details Form ===== -->
      <AnchorPane layoutX="24.0" layoutY="396.0" prefHeight="274.0" prefWidth="1032.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F3864;" text="Material Details" />

            <!-- Row 1 -->
            <Label layoutX="16.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Material Code" />
            <TextField fx:id="codeTxtField" layoutX="16.0" layoutY="58.0" prefHeight="34.0" prefWidth="235.0" promptText="e.g. ST-001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="267.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Material Name" />
            <TextField fx:id="nameTxtField" layoutX="267.0" layoutY="58.0" prefHeight="34.0" prefWidth="255.0" promptText="e.g. Mild Steel Angle 40x40" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="538.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Material Type" />
            <ComboBox fx:id="typeCombo" layoutX="538.0" layoutY="58.0" prefHeight="34.0" prefWidth="240.0" promptText="Select type" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="794.0" layoutY="38.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Unit" />
            <ComboBox fx:id="unitCombo" layoutX="794.0" layoutY="58.0" prefHeight="34.0" prefWidth="222.0" promptText="Select unit" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <!-- Row 2 -->
            <Label layoutX="16.0" layoutY="104.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Size Specification" />
            <TextField fx:id="sizeSpecTxtField" layoutX="16.0" layoutY="124.0" prefHeight="34.0" prefWidth="235.0" promptText="e.g. 40x40x5mm" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="267.0" layoutY="104.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Unit Cost (Rs.)" />
            <TextField fx:id="unitCostTxtField" layoutX="267.0" layoutY="124.0" prefHeight="34.0" prefWidth="255.0" promptText="0.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="538.0" layoutY="104.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Quantity On Hand" />
            <TextField fx:id="qtyTxtfield" layoutX="538.0" layoutY="124.0" prefHeight="34.0" prefWidth="240.0" promptText="0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Label layoutX="794.0" layoutY="104.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Re-order Level" />
            <TextField fx:id="reorderLevelTxtField" layoutX="794.0" layoutY="124.0" prefHeight="34.0" prefWidth="222.0" promptText="0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <!-- Row 3: Supplier + Action Buttons -->
            <Label layoutX="16.0" layoutY="170.0" style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Default Supplier" />
            <ComboBox fx:id="supplierCombo" layoutX="16.0" layoutY="190.0" prefHeight="34.0" prefWidth="320.0" promptText="Select supplier" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />

            <Button fx:id="saveBtn" layoutX="356.0" layoutY="216.0" mnemonicParsing="false" onAction="#clickBtnSave" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save" />
            <Button fx:id="updateBtn" layoutX="518.0" layoutY="216.0" mnemonicParsing="false" onAction="#clickBtnUpdate" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Update" />
            <Button fx:id="deleteBtn" layoutX="680.0" layoutY="216.0" mnemonicParsing="false" onAction="#clickBtnDelete" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #D64545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Delete" />
            <Button fx:id="clearBtn" layoutX="842.0" layoutY="216.0" mnemonicParsing="false" onAction="#clickBtnClear" prefHeight="38.0" prefWidth="174.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear" />
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
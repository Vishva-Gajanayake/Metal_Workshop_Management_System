<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="quotationPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.QuotationsController">
   <children>
      <VBox prefHeight="720.0" prefWidth="1080.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-text-fill: #6B7280;" text="Generate client quotations from cost estimates and track approval status">
               <VBox.margin>
                  <Insets left="24.0" top="12.0" />
               </VBox.margin>
            </Label>

            <HBox prefHeight="668.0" prefWidth="1080.0" spacing="16.0">
               <children>
                  <VBox prefHeight="644.0" prefWidth="586.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="554.0" spacing="12.0">
                           <children>
                              <TextField fx:id="searchTxtField" onKeyPressed="#pressedSearch" prefHeight="34.0" prefWidth="340.0" promptText="Quotation No (press Enter), e.g. QUO-0001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <padding>
                              <Insets left="16.0" right="16.0" top="10.0" />
                           </padding>
                        </HBox>
                        <TableView fx:id="quoteTbl" prefHeight="562.0" prefWidth="554.0">
                           <columns>
                              <TableColumn fx:id="colNo" prefWidth="112.0" text="Quotation No" />
                              <TableColumn fx:id="colClient" prefWidth="148.0" text="Client" />
                              <TableColumn fx:id="colTotal" prefWidth="102.0" text="Total" />
                              <TableColumn fx:id="colValidDate" prefWidth="100.0" text="Valid Until" />
                              <TableColumn fx:id="colStatus" prefWidth="92.0" text="Status" />
                           </columns>
                           <VBox.margin>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="4.0" />
                           </VBox.margin>
                        </TableView>
                     </children>
                  </VBox>

                  <VBox prefHeight="644.0" prefWidth="430.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label fx:id="quoteNoLbl" style="-fx-text-fill: #1F3864;" text="-">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <Label fx:id="clientNameLbl" style="-fx-text-fill: #6B7280;" text="Client Name">
                                 <font>
                                    <Font size="13.0" />
                                 </font>
                              </Label>
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" top="12.0" />
                           </VBox.margin>
                        </VBox>

                        <VBox prefHeight="54.0" prefWidth="398.0" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Estimate" />
                              <ComboBox fx:id="estimateCombo" prefHeight="32.0" prefWidth="398.0" promptText="Select estimate" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </VBox>

                        <HBox prefHeight="54.0" prefWidth="398.0" spacing="12.0">
                           <children>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Profit Margin %" />
                                    <TextField fx:id="profitTxtField" prefHeight="32.0" prefWidth="193.0" promptText="e.g. 20" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Discount (Rs.)" />
                                    <TextField fx:id="discountTxtField" prefHeight="32.0" prefWidth="193.0" promptText="e.g. 0.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </HBox>

                        <HBox prefHeight="54.0" prefWidth="398.0" spacing="12.0">
                           <children>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Quotation Date" />
                                    <DatePicker fx:id="quotationDatePicker" prefHeight="32.0" prefWidth="193.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Valid Until" />
                                    <DatePicker fx:id="validUntilDatePicker" prefHeight="32.0" prefWidth="193.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </HBox>

                        <HBox prefHeight="54.0" prefWidth="398.0" spacing="12.0">
                           <children>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Advance Required (Rs.)" />
                                    <TextField fx:id="advanceTxtField" prefHeight="32.0" prefWidth="193.0" promptText="e.g. 10000.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="54.0" prefWidth="193.0" spacing="3.0">
                                 <children>
                                    <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Status" />
                                    <ComboBox fx:id="statusCombo" prefHeight="32.0" prefWidth="193.0" promptText="Select status" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                                 </children>
                              </VBox>
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </HBox>

                        <VBox prefHeight="76.0" prefWidth="398.0" spacing="4.0" style="-fx-background-color: #F4F6FA; -fx-border-color: #D9DEE7; -fx-background-radius: 8; -fx-border-radius: 8;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#clickCalculateBtn" prefHeight="28.0" prefWidth="140.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="CALCULATE TOTAL" />
                                    <Label fx:id="totalLbl" style="-fx-text-fill: #1F3864;" text="RS.0.00">
                                       <font>
                                          <Font name="System Bold" size="22.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" top="4.0" />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                           </padding>
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#clickSaveBtn" prefHeight="36.0" prefWidth="398.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-background-color: #2E75B6; -fx-background-radius: 6; -fx-cursor: hand;" text="SAVE QUOTATION">
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" top="2.0" />
                           </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="398.0" spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#clickMarkAccepted" prefHeight="34.0" prefWidth="194.0" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2E9E5B; -fx-background-radius: 6; -fx-cursor: hand;" text="Mark Accepted" />
                              <Button mnemonicParsing="false" onAction="#clickMarkReject" prefHeight="34.0" prefWidth="194.0" style="-fx-background-radius: 6; -fx-font-weight: bold; -fx-background-color: #C0392B; -fx-text-fill: white; -fx-cursor: hand;" text="Mark Reject" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </HBox>

                        <Button mnemonicParsing="false" onAction="#clickCleanBtn" prefHeight="34.0" prefWidth="398.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear Form">
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="24.0" right="24.0" top="8.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="serviceCategoriesPane" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F4F6FA;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.metalworkshopmanagementsystem.controller.ServiceCategoriesController">
   <children>
      <VBox prefHeight="720.0" prefWidth="1080.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-text-fill: #6B7280;" text="Configure fabrication service categories, labour rates, and default wastage">
               <VBox.margin>
                  <Insets left="24.0" top="12.0" />
               </VBox.margin>
            </Label>

            <HBox prefHeight="668.0" prefWidth="1080.0" spacing="16.0">
               <children>
                  <VBox prefHeight="644.0" prefWidth="616.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="584.0" spacing="12.0">
                           <children>
                              <TextField fx:id="searchTxtField" onKeyPressed="#pressSearchCategory" prefHeight="34.0" prefWidth="320.0" promptText="Category ID, e.g. SC001" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                              <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#clickBtnSearch" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Search" />
                           </children>
                           <padding>
                              <Insets left="16.0" right="16.0" top="10.0" />
                           </padding>
                        </HBox>
                        <TableView fx:id="catTbl" prefHeight="562.0" prefWidth="584.0">
                           <columns>
                              <TableColumn fx:id="colId" prefWidth="85.0" text="ID" />
                              <TableColumn fx:id="colCategory" prefWidth="165.0" text="Category" />
                              <TableColumn fx:id="colUnit" prefWidth="100.0" text="Unit" />
                              <TableColumn fx:id="colLabourRate" prefWidth="122.0" text="Labour Rate" />
                              <TableColumn fx:id="colWastage" prefWidth="112.0" text="Wastage %" />
                           </columns>
                           <VBox.margin>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="4.0" />
                           </VBox.margin>
                        </TableView>
                     </children>
                  </VBox>

                  <VBox prefHeight="644.0" prefWidth="400.0" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 10; -fx-border-radius: 10;">
                     <children>
                        <Label style="-fx-text-fill: #1F3864;" text="Category Details">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                           <VBox.margin>
                              <Insets left="16.0" top="14.0" />
                           </VBox.margin>
                        </Label>

                        <VBox prefHeight="62.0" prefWidth="368.0" spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Category Name" />
                              <TextField fx:id="catNameTxtField" prefHeight="34.0" prefWidth="368.0" promptText="e.g. Gate &amp; Grill" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </VBox>

                        <VBox prefHeight="62.0" prefWidth="368.0" spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Unit of Measure" />
                              <ComboBox fx:id="unitCombo" prefHeight="34.0" prefWidth="368.0" promptText="Select unit" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </VBox>

                        <VBox prefHeight="62.0" prefWidth="368.0" spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Labour Rate (Rs.)" />
                              <TextField fx:id="labourRateTxtField" prefHeight="34.0" prefWidth="368.0" promptText="e.g. 1500.00" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </VBox>

                        <VBox prefHeight="62.0" prefWidth="368.0" spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #1F3864; -fx-font-weight: bold;" text="Default Wastage %" />
                              <TextField fx:id="wastageTxtField" prefHeight="34.0" prefWidth="368.0" promptText="e.g. 5.0" style="-fx-background-color: white; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6;" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" prefHeight="44.0" prefWidth="368.0" spacing="10.0">
                           <children>
                              <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#clickBtnSave" prefHeight="36.0" prefWidth="116.0" style="-fx-background-color: #2E75B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Save" />
                              <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#clickBtnUpdate" prefHeight="36.0" prefWidth="116.0" style="-fx-background-color: #2E9E5B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Update" />
                              <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#clickBtnDelete" prefHeight="36.0" prefWidth="116.0" style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Delete" />
                           </children>
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" top="6.0" />
                           </VBox.margin>
                        </HBox>

                        <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#clickBtnClear" prefHeight="36.0" prefWidth="368.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-color: #D9DEE7; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;" text="Clear Form">
                           <VBox.margin>
                              <Insets left="16.0" right="16.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="24.0" right="24.0" top="8.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>